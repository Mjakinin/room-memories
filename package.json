{
  "name": "room-memories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private video-to-3D memory archive built on Nerfstudio, COLMAP and SuperSplat.",
  "scripts": {
    "dev": "node scripts/prepare-site.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-site.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "rooms": "node scripts/rooms.mjs",
    "password": "node scripts/password.mjs",
    "publish": "node scripts/publish.mjs",
    "backup": "python3 scripts/archive.py backup",
    "restore": "python3 scripts/archive.py restore",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@playcanvas/splat-transform": "3.9.0",
    "@playcanvas/supersplat-viewer": "1.37.0",
    "playcanvas": "2.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
